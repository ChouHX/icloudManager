# 复制为 .env 后修改(docker compose 会自动读取同目录的 .env)
# .env 已被 .gitignore 忽略,不会提交到仓库

# 管理员密码,必填,至少 8 位;未设置时 compose 会拒绝启动
ICLOUD_HME_ADMIN_PASSWORD=change-this-before-running-2026

# 会话有效期,范围 15m-168h
ICLOUD_HME_SESSION_TTL=12h

# 通过 TLS 反向代理部署时设为 true(给会话 Cookie 加上 Secure)
ICLOUD_HME_SECURE_COOKIE=false

# 每个账号的 IMAP 并发连接数(取件并行度),范围 1-50
ICLOUD_HME_IMAP_POOL_SIZE=10

# 容器时区
TZ=Asia/Shanghai

# 宿主机监听端口
ICLOUD_HME_PORT=8081
